# Codex2CC 环境变量示例 — 复制为 .env 后按需修改

# ---- 服务 ----
# 监听端口（默认 8989）
CODEX_PORT=8989
# 监听地址，默认 0.0.0.0（兼容 Docker / 反代）；仅本机可设 127.0.0.1
CODEX_BIND=0.0.0.0
# 管理后台密钥；留空时首次访问 /admin/ 会引导自助初始化
ADMIN_SECRET=

# ---- 数据库（二选一）----
# PostgreSQL（默认驱动）
DATABASE_DRIVER=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=codex2cc
# 可选：DATABASE_SCHEMA=codex2cc  DATABASE_SSLMODE=disable
# SQLite（轻量部署）
# DATABASE_DRIVER=sqlite
# DATABASE_PATH=./data/codex2cc.db

# ---- 缓存（二选一）----
# 内存缓存（默认，无需额外组件）
CACHE_DRIVER=memory
# Redis
# CACHE_DRIVER=redis
# REDIS_ADDR=127.0.0.1:6379
# REDIS_PASSWORD=
# 可选：REDIS_USERNAME=  REDIS_DB=0  REDIS_TLS=false  REDIS_INSECURE_SKIP_VERIFY=false

# ---- 凭据加密（可选）----
# 设置后 SQLite/DB 中的上游凭据将以 AES 加密存储；轮换需同步重导凭据
# CODEX_CRED_ENCRYPTION_KEY=

# ---- 时区 ----
TZ=Asia/Shanghai
